# Управляется Ansible — не редактировать вручную
server {
    listen {{ nginx_http_port }};
    listen [::]:{{ nginx_http_port }};

    server_name {{ domain }};
    server_tokens {{ nginx_server_tokens }};

    # Каталог для ACME-челленджей certbot (--webroot)
    location ^~ /.well-known/acme-challenge/ {
        root {{ nginx_webroot }};
        default_type "text/plain";
    }

{% if ssl_enabled | bool and nginx_cert is defined and (nginx_cert.stat.exists | default(false)) %}
    # HTTP → HTTPS редирект
    location / {
        return 301 https://$host$request_uri;
    }
{% else %}
    # Проксирование на Docker-контейнер приложения
    location / {
        proxy_pass http://127.0.0.1:{{ app_http_port }};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
{% endif %}
}